# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
MAX_CONTENT_LENGTH=1048576
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Set this in production. Leave empty only for local development.
APP_API_KEY=
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
STORE_SOURCE_INPUTS=true

# LLM provider: gemini, nvidia, gemma
ACTIVE_LLM=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
HF_API_KEY=
GEMMA_MODEL=google/gemma-2-9b-it
GEMMA_API_URL=

# Real Behave LLM tests are opt-in.
RUN_LLM_TESTS=0
